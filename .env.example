SUPABASE_URL=https://your-project.supabase.co
# Recommended for new projects:
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Legacy alternative to SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=replace_me
SUPABASE_ALLOWED_TABLES=your_table
# At least 32 characters. Generate with: openssl rand -hex 32
MCP_API_KEY=replace_with_a_long_random_value
# Optional: npm run smoke performs a read-only probe against this table.
# MCP_SMOKE_TABLE=your_table
