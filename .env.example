SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_your_service_role_key
# Available in Supabase, but not used by this MCP server:
# SUPABASE_ACCESS_TOKEN=replace_me
# SUPABASE_ANON_KEY=replace_me
# SUPABASE_PUBLISH_KEY=replace_me
SUPABASE_ALLOWED_TABLES=your_table
# At least 32 characters. Generate with: openssl rand -hex 32
MCP_API_KEY=replace_with_a_long_random_value
# Optional: npm run smoke performs a read-only probe against this table.
# MCP_SMOKE_TABLE=your_table
# MCP_SMOKE_MIN_ROWS=1
