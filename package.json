{
  "name": "mcp-ipostock",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npx --yes vercel@57.0.0 dev",
    "check": "npm test && npm run typecheck",
    "smoke": "node --env-file-if-exists=.env.local scripts/smoke.mjs",
